# --- ML: Hugging Face / training outputs ---
# local HF cache dir you pointed at
backend/ai/models/hub/
# trainer outputs/checkpoints
backend/ai/services/train/checkpoints/
# any accidental large artifacts
backend/ai/models/**/*.bin
backend/ai/models/**/*.pt
backend/ai/models/**/*.ckpt
# keep safetensors/config/tokenizer/json files under models
!backend/ai/models/**/model.safetensors
!backend/ai/models/**/config.json
!backend/ai/models/**/tokenizer_config.json
!backend/ai/models/**/tokenizer.json
!backend/ai/models/**/vocab.txt
!backend/ai/models/**/special_tokens_map.json

